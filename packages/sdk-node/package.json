{
  "name": "@iwifunni-flag/core",
  "version": "0.1.0",
  "private": true,
  "description": "Iwifunni Node.js SDK: evaluate flags locally from one downloaded configuration snapshot.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "imports": {
    "#client": "./src/client.ts",
    "#errors": "./src/errors.ts"
  },
  "scripts": {
    "build": "node scripts/package.mjs",
    "package": "pnpm run build && cd dist && npm pack",
    "test:package": "pnpm run build && node scripts/smoke.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src",
    "format": "biome format --write src",
    "test": "vitest run"
  },
  "dependencies": {
    "@iwifunni/contracts": "workspace:*",
    "@iwifunni/engine": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^20",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
