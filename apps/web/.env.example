# Iwifunni Web — copy to `.env` and fill in.
#
#   cp apps/web/.env.example apps/web/.env

# Base URL of the Iwifunni API (apps/api), as reached from the browser. No
# trailing slash. Required for production builds; Next.js inlines it into the
# client bundle because of the `NEXT_PUBLIC_` prefix.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Server-only. Base URL Server Components use to reach the API without a round
# trip through the public origin. Defaults to NEXT_PUBLIC_API_URL's default when
# unset.
API_INTERNAL_URL=http://localhost:4000

# PostHog browser analytics. Both are optional: leave them empty and the app runs
# with analytics off. The key is the public project token from PostHog project
# settings, which the browser sends, so there is no secret to keep here.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
