# Dariise API — copy to `.env` and fill in.
#
#   cp apps/api/.env.example apps/api/.env

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# PostgreSQL. Port 5442 matches docker-compose.yml, which avoids the unrelated
# stack already occupying 5432/5435 on the development machine.
DATABASE_URL=postgresql://postgres:postgres@localhost:5442/dariise

# Signing secret for sessions. At least 32 characters. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# The origin the browser reaches the API on. Must match, or session cookies are
# issued for the wrong host and sign-in appears to succeed but never persists.
BETTER_AUTH_URL=http://localhost:4000

# Transactional email (password resets) via Brevo. Both are required: the API
# validates them at startup, and EMAIL_FROM must be a sender verified in your
# Brevo account.
BREVO_API_KEY=
EMAIL_FROM=no-reply@your-domain.example

# The sender name shown in a recipient's inbox. Defaults to Dariise.
# EMAIL_SENDER_NAME=Dariise

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# development | test | production
# NODE_ENV=development

# PORT=4000

# Max PostgreSQL connections this process will open. Keep instances * max below
# the server's max_connections.
# DATABASE_POOL_MAX=10

# Cache only — never on the critical path. See docs/architecture.md §8.1.
# The API starts and serves with Redis unreachable.
# REDIS_URL=redis://localhost:6389

# Social sign-in. A provider needs BOTH values to be enabled; a half-configured
# provider is treated as absent, and the dashboard dims its button.
#
# Redirect URI to register with each provider:
#   http://localhost:4000/api/auth/callback/github
#   http://localhost:4000/api/auth/callback/google
#
# GitHub: include the `user:email` scope, or sign-in fails with `email_not_found`.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
