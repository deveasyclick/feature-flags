{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Iwifunni API — Hono on Node.js, Drizzle over PostgreSQL, Better Auth for sessions.",
  "scripts": {
    "dev": "tsx watch --import ./instrument.mjs src/server.ts",
    "build": "tsc --project tsconfig.build.json && node scripts/copy-email-templates.mjs",
    "start": "node --import ./instrument.mjs dist/server.js",
    "lint": "biome lint src",
    "format": "biome format --write src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "auth:generate": "pnpm dlx @better-auth/cli@latest generate --config src/modules/auth/auth.cli.ts --output src/db/auth-schema.generated.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.5",
    "@iwifunni/contracts": "workspace:*",
    "@iwifunni/engine": "workspace:*",
    "@getbrevo/brevo": "^6.0.3",
    "@hono/node-server": "^2.1.1",
    "@sentry/hono": "^11.7.0",
    "@sentry/node": "^11.7.0",
    "@sentry/profiling-node": "^11.7.0",
    "better-auth": "^1.7.5",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.8",
    "mjml": "^5.4.1",
    "pg": "^8.23.0",
    "pino": "^10.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/mjml": "^5.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}